# PostgreSQL（生产/容器）
DATABASE_URL=postgresql+psycopg://roast:roast@localhost:5432/roastlog
# 本地开发可留空使用 SQLite（backend/data/roast.db）
# DATABASE_URL=sqlite+pysqlite:///./data/roast.db

# 温升率默认末端窗口（秒）
ROR_WINDOW_S=30
# 允许线性插值补绘的最大探针失联时长（秒），严格小于才插值
MAX_INTERP_GAP_S=12
ROR_MIN_ANCHORS=4
ROR_MIN_COVERAGE=0.5

SEED_ON_STARTUP=true
